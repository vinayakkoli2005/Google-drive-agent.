# Google Gemini API key
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=service_account.json

# The Google Drive folder ID to search within (copy the sample folder to your Drive first)
GOOGLE_DRIVE_FOLDER_ID=your_copied_folder_id_here

# (Frontend only) URL of the deployed FastAPI backend
# Leave blank or set to http://127.0.0.1:8000 for local development
BACKEND_URL=https://your-backend-service.onrender.com
